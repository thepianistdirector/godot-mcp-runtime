; Engine configuration file.
; Godot 4 fixture for tests/integration/input-and-embedding.test.ts: a 640x360 viewport stretched
; into a 1280x720 window (integer scale), Controls inside SubViewportContainers, a rotated Control,
; an embedded Window, and a recorder of every mouse event's button_mask.
; See tests/fixtures/README.md for usage.

config_version=5

[application]

config/name="godot-mcp-runtime input fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
